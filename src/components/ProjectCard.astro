---
import { t } from '../i18n/utils';
const { name, description, repo, demo, language, tech = [], image } = Astro.props;
---

<div class="flex flex-col bg-skin-card rounded-lg shadow overflow-hidden h-full border border-skin-base">
  {image && (
    <a href={repo} target="_blank" class="block">
      <img class="w-full aspect-video object-cover" src={image} alt={name} loading="lazy" />
    </a>
  )}
  <div class="flex flex-col flex-1 p-4 gap-2">
    <div class="flex items-center justify-between">
      <a href={repo} target="_blank" class="text-lg font-bold truncate hover:text-skin-active" title={name}>
        {name}
      </a>
      {language && (
        <span class="text-xs flex items-center shrink-0 ml-2">
          <span class="w-2 h-2 rounded-full mr-1" style="background-color: rgb(var(--color-text-active));" />
          {language}
        </span>
      )}
    </div>
    <p class="text-sm break-words flex-1">{description}</p>
    {tech.length > 0 && (
      <div class="flex flex-wrap">
        {tech.map((item) => (
          <span class="inline-block truncate m-1 border p-1 text-xs rounded" style="line-height: 16px;">
            {item}
          </span>
        ))}
      </div>
    )}
    <div class="flex items-center gap-4 pt-2 mt-auto">
      <a href={repo} target="_blank" class="flex items-center text-sm hover:text-skin-active">
        <i class="ri-github-fill text-lg mr-1" />
        {t('projects.viewCode')}
      </a>
      {demo && (
        <a href={demo} target="_blank" class="flex items-center text-sm hover:text-skin-active">
          <i class="ri-external-link-line text-lg mr-1" />
          {t('projects.liveDemo')}
        </a>
      )}
    </div>
  </div>
</div>
